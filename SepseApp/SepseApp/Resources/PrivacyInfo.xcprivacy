<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- O app não faz rastreamento (App Tracking Transparency). -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Nenhum dado é coletado/transmitido: tudo permanece localmente no dispositivo. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- Nenhuma API de "motivo exigido" (UserDefaults/timestamps de arquivo/etc.) é usada. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
